# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan commit .env.local (sudah diblokir .gitignore).

# Wajib - Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional - hanya untuk seed & migrasi dari mesin lokal
# Project Settings -> API -> service_role (RAHASIA, jangan bocor ke browser)
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database. Gunakan port 6543 (transaction pooler) untuk app.
DATABASE_URL=
